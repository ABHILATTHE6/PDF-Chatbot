# PDF Chatbot environment configuration
# Copy this file to .env locally and fill in the values required by the implementation.

# LLM provider
LLM_API_KEY=
LLM_MODEL=

# Embedding provider
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Vector store / application configuration
VECTOR_STORE_PATH=./data/vector_store
MAX_UPLOAD_SIZE_MB=25
TOP_K_RESULTS=5

# Application
APP_ENV=development
LOG_LEVEL=INFO
